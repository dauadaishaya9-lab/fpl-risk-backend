# Existing backend
DATABASE_URL=postgresql://...

# Clerk backend verification via rotating JWKS
CLERK_ISSUER=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Exact browser origins allowed to authenticate against this API.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://YOUR-FRONTEND-DOMAIN
FRONTEND_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND-DOMAIN

# Optional internal loopback port for the legacy backend.
INTERNAL_PORT=3001
