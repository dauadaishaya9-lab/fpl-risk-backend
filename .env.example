# Existing backend
DATABASE_URL=postgresql://...

# Clerk backend verification
# Copy the PEM public key from Clerk Dashboard -> API Keys -> JWT Public Key.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Exact issuer for your Clerk instance, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev
# Exact frontend origins allowed to authenticate against this API.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://YOUR-FRONTEND-DOMAIN
FRONTEND_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND-DOMAIN

# Optional internal loopback port for the legacy backend.
INTERNAL_PORT=3001
